<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header (always visible elements) --}}
  <header class="sheet-header">
    <div class="resources grid grid-2col">
      {{!-- LEFT SIDE: STATUSES --}}
      <div class="header-fields">
        <div class="resources grid grid-2col">
          <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
          
          <div class="resource flex-group-left">
            <h1 class="biginput" id="kith"><input type="text" name="system.kith" value="{{system.kith}}" placeholder="Kith" /></h1>
            <h1 class="biginput" id="kin"><input type="text" name="system.kin" value="{{system.kin}}" placeholder="Kin" /></h1>
            
            <div class="smallinput resources" id="stressed">
              <label for="system.status.stressed" class="resource-label">Stressed</label>
              <div class="resource-content">
                <input type="checkbox" name="system.status.stressed" {{isChecked system.status.stressed}} />
              </div>
            </div>
            
            <div class="smallinput resources" id="staggered">
              <label for="system.status.staggered" class="resource-label">Staggered</label>
              <div class="resource-content">
                <input type="checkbox" name="system.status.staggered" {{isChecked system.status.staggered}} />
              </div>
            </div>
            
            <div class="smallinput resources" id="injured">
              <label for="system.status.injured" class="resource-label">Injured</label>
              <div class="resource-content">
                <input type="checkbox" name="system.status.injured" {{isChecked system.status.injured}} />
              </div>
            </div>
            
            <div class="smallinput resources" id="deathsdoor">
              <label for="system.status.deathsdoor" class="resource-label">Death's Door</label>
              <div class="resource-content">
                <input type="checkbox" name="system.status.deathsdoor" {{isChecked system.status.deathsdoor}} />
              </div>
            </div>
          </div>
        </div>
        <h1 class="biginput" id="charname"><input type="text" name="name" value="{{actor.name}}" placeholder="Name"/></h1>
      </div>

      {{!-- RIGHT SIDE: ATTRIBUTES --}}
      <div class="resource flex-group-center">
        <div class="resources grid grid-4col">

          <div class="resource flex-group-center">
            <label for="system.swords" class="resource-label">Swords</label>
            <div class="resource-content flexrow flex-center flex-between">
              <input type="number" name="system.swords" value="{{system.swords}}" data-dtype="Number"/>
            </div>
          </div>

          <div class="resource flex-group-center">
            <label for="system.pentacles" class="resource-label">Pentacles</label>
            <div class="resource-content flexrow flex-center flex-between">
              <input type="number" name="system.pentacles" value="{{system.pentacles}}" data-dtype="Number" />
            </div>
          </div>

          <div class="resource flex-group-center">
            <label for="system.cups" class="resource-label">Cups</label>
            <div class="resource-content flexrow flex-center flex-between">
              <input type="number" name="system.cups" value="{{system.cups}}" data-dtype="Number" />
            </div>
          </div>

          <div class="resource flex-group-center">
            <label for="system.wands" class="resource-label">Wands</label>
            <div class="resource-content flexrow flex-center flex-between">
              <input type="number" name="system.wands" value="{{system.wands}}" data-dtype="Number" />
            </div>
          </div>

        </div>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation - reference template https://github.com/asacolips-projects/boilerplate/blob/main/templates/actor/actor-character-sheet.hbs --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="biography">Biography</a>
    <a class="item" data-tab="talents">Talents</a>
    <a class="item" data-tab="pack">Pack</a>
    {{!-- <a class="item" data-tab="spells">Spells</a> --}}
    {{!-- <a class="item" data-tab="effects">Effects</a> --}}
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="biography">
      {{> "systems/hmtw-foundry/templates/actor/parts/actor-bio.hbs"}}
    </div>

    {{!-- Talents Tab --}}
    <div class="tab talents" data-group="primary" data-tab="talents">
      {{> "systems/hmtw-foundry/templates/actor/parts/actor-talents.hbs"}}
    </div>

    {{!-- Pack Tab --}}
    <div class="tab pack" data-group="primary" data-tab="pack">
      {{> "systems/hmtw-foundry/templates/actor/parts/actor-pack.hbs"}}
    </div>

    {{!-- Spells Tab --}}
    {{!-- <div class="tab spells" data-group="primary" data-tab="spells">
      {{> "systems/hmtw-foundry/templates/actor/parts/actor-spells.hbs"}}
    </div> --}}

    {{!-- Active Effects Tab --}}
    {{!-- <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/hmtw-foundry/templates/actor/parts/actor-effects.hbs"}}
    </div> --}}

  </section>
</form>
